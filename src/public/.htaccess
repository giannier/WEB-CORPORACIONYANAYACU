# Apache / LiteSpeed config for cPanel hosting. Copied to the root of dist/ on every build.

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Block the project files that live next to the site when the repo is cloned inside public_html
  #    (cPanel Git Version Control). They must never be public or indexed. REQUEST_URI is matched on
  #    purpose so the rule also works from the nested dist/.htaccess copy.
  RewriteCond %{REQUEST_URI} ^/(src|dist|tools|node_modules)(/|$) [NC,OR]
  RewriteCond %{REQUEST_URI} ^/(build\.mjs|package(-lock)?\.json|README\.md|SEO-AUDIT\.md|\.cpanel\.yml|\.gitignore)$ [NC,OR]
  RewriteCond %{REQUEST_URI} \.(mjs|py|md|ya?ml)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 2) One canonical origin: https://corporacionyanayacu.com (single 301 hop, no www).
  #    Skipped for /.well-known/ so AutoSSL domain validation over HTTP keeps working.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://corporacionyanayacu.com%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://corporacionyanayacu.com%{REQUEST_URI} [L,R=301]

  # 3) Block hidden files (except .well-known, needed by AutoSSL)
  RewriteRule ^\.(?!well-known) - [F]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
